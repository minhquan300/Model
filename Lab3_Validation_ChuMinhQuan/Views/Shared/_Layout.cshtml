<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab 3 Validation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f7fb; }
        .page-card { max-width: 900px; margin: 35px auto; padding: 28px; background: white; border-radius: 12px; box-shadow: 0 3px 16px #00000012; }
        .field-validation-error, .validation-summary-errors { color: #dc3545; }
        .input-validation-error { border-color: #dc3545; }
        .form-group { margin-bottom: 16px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Student" asp-action="Index">Lab 3 - Validation</a>
        </div>
    </nav>
    <main class="container">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
