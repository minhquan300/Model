@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="page-card">
    <h2 class="mb-4">Thêm sinh viên</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-controller="Student" asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Branch" class="form-label"></label>
            <select asp-for="Branch" asp-items="Html.GetEnumSelectList<Branch>()" class="form-select">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label d-block">Giới tính</label>
            @foreach (var item in Html.GetEnumSelectList<Gender>())
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Gender" value="@item.Value" id="gender_@item.Value" />
                    <label class="form-check-label" for="gender_@item.Value">@item.Text</label>
                </div>
            }
            <div><span asp-validation-for="Gender" class="text-danger"></span></div>
        </div>

        <div class="form-group form-check">
            <input asp-for="IsRegular" class="form-check-input" />
            <label asp-for="IsRegular" class="form-check-label"></label>
        </div>

        <div class="form-group">
            <label asp-for="Address" class="form-label"></label>
            <textarea asp-for="Address" rows="3" class="form-control"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Score" class="form-label"></label>
            <input asp-for="Score" type="number" min="0" max="10" step="0.1" class="form-control" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Thêm sinh viên</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>
